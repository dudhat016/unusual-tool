rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reusable helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == "unusualgamerz16@gmail.com" ||
        request.auth.token.email == "chintandudhat1286@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        request.auth.uid == userId || isAdmin()
      );
      allow delete: if isAdmin();

      // User Subscriptions Sub-collection
      match /subscriptions/{subscriptionId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
        allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
        allow delete: if isAdmin();
      }

      // User Notepad Notes Sub-collection (Cloud Sync)
      match /notes/{noteId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    // User Favorites (Cross-device persistence)
    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() && (
        favoriteId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        favoriteId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        favoriteId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        favoriteId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // Credit Ledger - append only for users or admin
    match /credit_ledger/{ledgerId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // Processing Jobs / Telemetry
    match /processing_jobs/{jobId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Presets and Saved Configurations
    match /presets/{presetId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || resource.data.isPublic == true || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // Dynamic Tool Catalog (Public Read, Admin Write)
    match /tools/{toolId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tool CMS Contents (Public Read, Admin Write)
    match /toolContents/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Blog & Editorial Posts (Public Read, Admin Write, and view counter increment)
    match /blogs/{blogId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        request.resource.data.views is number
      );
    }

    match /blog_posts/{postId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        request.resource.data.views is number
      );
    }

    // Dynamic SEO Entries & Settings (Public Read, Admin Write)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /seo_entries/{entryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /seo_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Configurable SaaS Plans (Public Read, Admin Write)
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Configurable Credit Top-Up Packages (Public Read, Admin Write)
    match /credit_packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Social Media Mockup Generator Templates (Public Read, Admin Write)
    match /social_mockup_templates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System Settings & Feature Flags (Public Read, Admin Write)
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tool Usage Statistics & Telemetry Aggregation
    match /tool_usage_stats/{statId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    match /feature_flags/{flagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ad_slots/{slotId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin Audit Logs
    match /admin_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // System Error Logs
    match /error_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true; // Any client can log unexpected errors safely
      allow update, delete: if isAdmin();
    }

    // Rate Limiting Bucket
    match /rate_limits/{bucketId} {
      allow read, write: if true;
    }
  }
}
